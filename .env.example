# Server-side configuration for the future worker. No application consumes this yet.
# Ollama's existing systemd service does not load this file.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=proofsec-gemma:e4b-q4
# Expected alias digest from config/ollama/model-lock.json; verify before use.
OLLAMA_MODEL_DIGEST=e70f7ab65c6b1f83cc4b5fdefb47a78b882c6a41c841fcb6de5f19ec82f16c9b

# Defaults from docs/ai-layer-gemma.md. These require worker enforcement.
AI_CONTEXT_TOKENS=4096
AI_MAX_OUTPUT_TOKENS=768
AI_TEMPERATURE=0
AI_STREAM=false
AI_THINK=false
AI_MAX_CONCURRENT_REQUESTS=1
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_JOB_BUDGET_MS=65000
AI_MAX_INPUT_BYTES=24576
AI_MAX_RESPONSE_BYTES=16384
AI_PROMPT_VERSION=1
