{
  "name": "sicura",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": "24.13.0",
    "pnpm": "10.29.1"
  },
  "scripts": {
    "check:env": "node scripts/check-env.mjs",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run tests/unit/contracts.test.ts tests/unit/lifecycle.test.ts",
    "test:integration": "vitest run tests/integration",
    "verify": "node scripts/verify.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web",
    "dev:worker": "node scripts/dev.mjs --worker",
    "setup": "node scripts/setup.mjs",
    "test:ai": "vitest run tests/unit/ai.test.ts",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "eval:freeze": "tsx eval/harness/freeze.ts",
    "eval:deterministic": "tsx eval/harness/deterministic.ts",
    "eval:ai": "tsx eval/harness/ai.ts",
    "eval:report": "tsx eval/harness/report.ts",
    "eval": "node scripts/eval.mjs",
    "rehearse": "tsx scripts/rehearse.ts",
    "package": "pnpm run build && node scripts/package.mjs",
    "doctor": "node scripts/check-env.mjs",
    "test:package": "tsx scripts/consumer-rehearse.ts",
    "import:example": "tsx scripts/import-example.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "pgsql-parser": "17.9.17",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
